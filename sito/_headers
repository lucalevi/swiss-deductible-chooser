# Intestazioni di Cloudflare Pages per insurek.lucalevi.com.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JavaScript firmati da strumenti/versiona.py.
/assets/styles.css
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts.css
  Cache-Control: public, max-age=31536000, immutable
/assets/lingua.js
  Cache-Control: public, max-age=31536000, immutable
/assets/calcolo.js
  Cache-Control: public, max-age=31536000, immutable
/assets/insurek.js
  Cache-Control: public, max-age=31536000, immutable

# I premi cambiano una volta l'anno, verso fine settembre. Un giorno di cache
# non fa danno e toglie 250 KB di richieste a chi torna.
/dati/*
  Cache-Control: public, max-age=86400

# I due font che servono subito, anche come intestazione Link. Il <link
# rel="preload"> nell'HTML c'e' gia', ma porta `crossorigin` (obbligatorio per
# i font) e Cloudflare Pages non trasforma in Early Hints i <link> con
# attributi in piu'. Scritti qui invece li manda come 103 Early Hints: il
# browser comincia a scaricare i font mentre la pagina e' ancora in viaggio.
